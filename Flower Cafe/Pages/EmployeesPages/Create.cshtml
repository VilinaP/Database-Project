@page
@model Flower_Cafe.Pages.EmployeesPages.CreateModel

@{
    ViewData["Title"] = "Create Employee";
}

<section class="fc-employee-form-hero">
    <div>
        <span class="fc-pill">New Employee</span>
        <h1>Create Employee</h1>
        <p>
            Add a new employee profile, address, and starting wage information.
        </p>
    </div>

    <div class="fc-employee-form-hero-action">
        <a asp-page="./Index" class="btn btn-secondary">Back to Employees</a>
    </div>
</section>

<section class="fc-employee-form-card">
    <form method="post">
        <div asp-validation-summary="All" class="text-danger fc-validation-box"></div>

        <div class="fc-form-section">
            <div class="fc-form-section-header">
                <div>
                    <span class="fc-order-label">Profile</span>
                    <h2>Employee Information</h2>
                </div>
            </div>

            <div class="fc-employee-form-grid">
                <div class="form-group">
                    <label asp-for="Employees.EmployeesId" class="control-label">Staff ID</label>
                    <input asp-for="Employees.EmployeesId" class="form-control" />
                    <span asp-validation-for="Employees.EmployeesId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Employees.FirstName" class="control-label">First Name</label>
                    <input asp-for="Employees.FirstName" class="form-control" />
                    <span asp-validation-for="Employees.FirstName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Employees.LastName" class="control-label">Last Name</label>
                    <input asp-for="Employees.LastName" class="form-control" />
                    <span asp-validation-for="Employees.LastName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Employees.DateOfBirth" class="control-label">Date of Birth</label>
                    <input asp-for="Employees.DateOfBirth" class="form-control" type="date" />
                    <span asp-validation-for="Employees.DateOfBirth" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Employees.Ssn" class="control-label">SSN</label>
                    <input asp-for="Employees.Ssn" class="form-control" />
                    <span asp-validation-for="Employees.Ssn" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="fc-form-section">
            <div class="fc-form-section-header">
                <div>
                    <span class="fc-order-label">Address</span>
                    <h2>Contact Address</h2>
                </div>
            </div>

            <div class="fc-employee-form-grid fc-employee-address-grid">
                <div class="form-group fc-form-wide">
                    <label asp-for="Employees.Street" class="control-label">Street</label>
                    <input asp-for="Employees.Street" class="form-control" />
                    <span asp-validation-for="Employees.Street" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Employees.City" class="control-label">City</label>
                    <input asp-for="Employees.City" class="form-control" />
                    <span asp-validation-for="Employees.City" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Employees.State" class="control-label">State</label>
                    <input asp-for="Employees.State" class="form-control" maxlength="2" />
                    <span asp-validation-for="Employees.State" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Employees.Zip" class="control-label">Zip</label>
                    <input asp-for="Employees.Zip" class="form-control" />
                    <span asp-validation-for="Employees.Zip" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="fc-form-section">
            <div class="fc-form-section-header">
                <div>
                    <span class="fc-order-label">Starting Wage</span>
                    <h2>Wage Information</h2>
                </div>
            </div>

            <div class="fc-employee-form-grid">
                <div class="form-group">
                    <label asp-for="CurrentWage" class="control-label">Wage</label>
                    <input asp-for="CurrentWage" class="form-control" type="number" step="0.01" min="0" max="999999.99" />
                    <span asp-validation-for="CurrentWage" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CurrentWageType" class="control-label">Wage Type</label>
                    <select asp-for="CurrentWageType" class="form-control">
                        <option value="Hourly">Hourly</option>
                        <option value="Salary">Salary</option>
                    </select>
                    <span asp-validation-for="CurrentWageType" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CurrentWageStartDate" class="control-label">Wage Start Date</label>
                    <input asp-for="CurrentWageStartDate" class="form-control" type="date" />
                    <span asp-validation-for="CurrentWageStartDate" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="fc-employee-form-actions">
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            <input type="submit" value="Create Employee" class="btn btn-primary" />
        </div>
    </form>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}