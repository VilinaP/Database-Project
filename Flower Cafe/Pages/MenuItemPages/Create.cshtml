@page
@model Flower_Cafe.Pages.MenuItemPages.CreateModel

@{
    ViewData["Title"] = "Create Menu Item";
}

<section class="fc-menu-form-hero">
    <div>
        <span class="fc-pill">New Menu Item</span>
        <h1>Create Item</h1>
        <p>
            Add a new food, drink, flower, bouquet, or plant to the public menu.
        </p>
    </div>

    <div class="fc-menu-form-hero-action">
        <a asp-page="./Index" class="btn btn-secondary">Back to Menu</a>
    </div>
</section>

<section class="fc-menu-form-card">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger fc-validation-box"></div>

        <div class="fc-form-section">
            <div class="fc-form-section-header">
                <div>
                    <span class="fc-order-label">Menu Item</span>
                    <h2>Item Information</h2>
                </div>
            </div>

            <div class="fc-menu-form-grid">
                <div class="form-group">
                    <label asp-for="MenuItem.Name" class="control-label"></label>
                    <input asp-for="MenuItem.Name" class="form-control" />
                    <span asp-validation-for="MenuItem.Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MenuItem.Type" class="control-label">Category</label>
                    <select asp-for="MenuItem.Type" asp-items="Model.MenuItemTypeList" class="form-control"></select>
                    <span asp-validation-for="MenuItem.Type" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MenuItem.Price" class="control-label"></label>
                    <input asp-for="MenuItem.Price" class="form-control" />
                    <span asp-validation-for="MenuItem.Price" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="fc-menu-form-actions">
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            <input type="submit" value="Create Item" class="btn btn-primary" />
        </div>
    </form>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}