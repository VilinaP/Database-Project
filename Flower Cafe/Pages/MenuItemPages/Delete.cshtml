@page
@model Flower_Cafe.Pages.MenuItemPages.DeleteModel

@{
    ViewData["Title"] = "Delete Menu Item";
}

<h1>Delete Menu Item</h1>

<h3>Are you sure you want to delete this?</h3>

@if (Model.RelatedOrderItemCount > 0)
{
    <div class="alert alert-warning">
        This menu item appears in @Model.RelatedOrderItemCount order item record(s).
        Deleting it will also delete those related order item records.
    </div>
}

<div>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MenuItem.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MenuItem.Name)
        </dd>

        <dt class="col-sm-2">
            Category
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MenuItem.TypeNavigation.TypeName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MenuItem.Price)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MenuItem.Price)
        </dd>
    </dl>

    <form method="post" asp-route-id="@Model.MenuItem.MenuItemId">
        <input type="hidden" asp-for="MenuItem.MenuItemId" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>