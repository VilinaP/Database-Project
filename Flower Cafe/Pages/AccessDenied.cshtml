@page
@model Flower_Cafe.Pages.AccessDeniedModel

@{
    ViewData["Title"] = "Access Denied";
}

<section class="fc-access-denied-hero">
    <div>
        <span class="fc-pill">Restricted Page</span>
        <h1>Access Denied</h1>
        <p>
            You do not have permission to view this page.
        </p>
    </div>
</section>

<section class="fc-access-denied-card">
    <div class="fc-delete-warning-box">
        <span class="fc-delete-small-label">Permission Required</span>

        <h2>This page is not available for your account.</h2>

        <p>
            Return home or use the navigation menu to open a page your account can access.
        </p>
    </div>

    <div class="fc-access-denied-actions">
        <a asp-page="/Index" class="btn btn-primary">Return Home</a>
    </div>
</section>