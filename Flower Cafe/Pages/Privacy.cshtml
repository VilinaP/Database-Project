@page
@model PrivacyModel

@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="fc-simple-page-hero">
    <div>
        <span class="fc-pill">Privacy</span>
        <h1>Privacy Policy</h1>
        <p>
            Review how Flower Cafe handles basic site and account information.
        </p>
    </div>
</section>

<section class="fc-simple-page-card">
    <div class="fc-section-title-row">
        <div>
            <span class="fc-order-label">Policy</span>
            <h2>Flower Cafe Privacy</h2>
        </div>
    </div>

    <div class="fc-simple-page-content">
        <p>
            This page can be used to describe how Flower Cafe stores, protects, and uses customer,
            employee, order, and menu information.
        </p>

        <p>
            For now, this application only displays the project privacy page. Add your final privacy
            policy text here when your class or project requirements are ready.
        </p>
    </div>

    <div class="fc-simple-page-actions">
        <a asp-page="/Index" class="btn btn-secondary">Return Home</a>
    </div>
</section>